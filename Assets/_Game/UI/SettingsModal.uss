.settings-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease-out;
}

.settings-overlay--hidden {
    display: none;
    opacity: 0;
}

.settings-card {
    width: 680px;
    background-image: url("project:/Assets/_Game/button_square_line.png");
    -unity-slice-left: 9;
    -unity-slice-top: 9;
    -unity-slice-right: 9;
    -unity-slice-bottom: 9;
    -unity-slice-scale: 1;
    background-color: rgb(255, 252, 240);
    padding: 35px 40px;
    border-radius: 14px;
    align-items: center;
}

.settings-header {
    -unity-font-definition: url("project:/Assets/_Game/MainMenu/Distillery Strong SDF.asset");
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(30, 30, 30);
    margin-bottom: 30px;
    -unity-text-align: middle-center;
}

.settings-row {
    width: 100%;
    margin-bottom: 24px;
}

.settings-row-label {
    -unity-font-definition: url("project:/Assets/_Game/Map/CyGrotesk-KeyRegular SDF.asset");
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(40, 40, 40);
    margin-bottom: 8px;
}

.settings-controls-group {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.settings-value-label {
    -unity-font-definition: url("project:/Assets/_Game/Map/CyGrotesk-KeyRegular SDF.asset");
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(60, 60, 60);
    width: 60px;
    -unity-text-align: middle-right;
    margin-right: 15px;
}

.settings-mute-btn {
    width: 120px;
    height: 42px;
    font-size: 18px;
}

.settings-mute-btn--muted {
    background-color: rgb(255, 180, 180);
    color: rgb(120, 20, 20);
}

.settings-mute-btn--muted:hover {
    background-color: rgb(255, 200, 200);
}

.settings-close-btn {
    width: 220px;
    height: 52px;
    font-size: 24px;
    margin-top: 15px;
}
