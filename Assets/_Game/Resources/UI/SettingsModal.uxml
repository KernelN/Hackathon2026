<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="Common.uss" />
    <ui:VisualElement name="settings-modal" class="modal-overlay hidden">
        <ui:VisualElement class="modal-card">
            <ui:Label text="Configuración" class="modal-title" />
            
            <ui:VisualElement class="settings-section">
                <ui:VisualElement class="settings-row">
                    <ui:Label text="Música" class="settings-label" />
                    <ui:Toggle name="toggle-music-mute" text="Silenciar" class="settings-toggle" />
                </ui:VisualElement>
                <ui:Slider name="slider-music-volume" low-value="0" high-value="1" value="1" class="settings-slider" />
            </ui:VisualElement>

            <ui:VisualElement class="settings-section">
                <ui:VisualElement class="settings-row">
                    <ui:Label text="Efectos de Sonido" class="settings-label" />
                    <ui:Toggle name="toggle-sfx-mute" text="Silenciar" class="settings-toggle" />
                </ui:VisualElement>
                <ui:Slider name="slider-sfx-volume" low-value="0" high-value="1" value="1" class="settings-slider" />
            </ui:VisualElement>

            <ui:Button name="btn-close-settings" text="Cerrar" class="menu-btn modal-close-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
