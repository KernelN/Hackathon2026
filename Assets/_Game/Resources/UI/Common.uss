/* Common UI Toolkit stylesheet for Mi Increíble Paseo (800x600 reference) */

.root-container {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Typography Utility Classes */
.font-title {
    -unity-font: url("project://database/Assets/_Game/MainMenu/Distillery%20Strong.otf?fileID=12800000&guid=acb32c0eafdc9724b95ce2902a5dde67&type=3#Distillery Strong");
    -unity-font-definition: url("project://database/Assets/_Game/MainMenu/Distillery%20Strong.otf?fileID=12800000&guid=acb32c0eafdc9724b95ce2902a5dde67&type=3#Distillery Strong");
}

.font-body {
    -unity-font: url("project://database/Assets/_Game/Map/CyGrotesk-KeyRegular.otf?fileID=12800000&guid=7bfa2f5719265c345b314a9886cf4913&type=3#Cy Grotesk Key");
    -unity-font-definition: url("project://database/Assets/_Game/Map/CyGrotesk-KeyRegular.otf?fileID=12800000&guid=7bfa2f5719265c345b314a9886cf4913&type=3#Cy Grotesk Key");
}

/* Settings Controls Styling */
.settings-section {
    width: 100%;
    margin-bottom: 12px;
    padding: 10px 14px;
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.08);
}

.settings-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 6px;
}

.settings-label {
    -unity-font: url("project://database/Assets/_Game/Map/CyGrotesk-KeyRegular.otf?fileID=12800000&guid=7bfa2f5719265c345b314a9886cf4913&type=3#Cy Grotesk Key");
    -unity-font-definition: url("project://database/Assets/_Game/Map/CyGrotesk-KeyRegular.otf?fileID=12800000&guid=7bfa2f5719265c345b314a9886cf4913&type=3#Cy Grotesk Key");
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(30, 30, 30);
}

.settings-toggle {
    -unity-font: url("project://database/Assets/_Game/Map/CyGrotesk-KeyRegular.otf?fileID=12800000&guid=7bfa2f5719265c345b314a9886cf4913&type=3#Cy Grotesk Key");
    -unity-font-definition: url("project://database/Assets/_Game/Map/CyGrotesk-KeyRegular.otf?fileID=12800000&guid=7bfa2f5719265c345b314a9886cf4913&type=3#Cy Grotesk Key");
    font-size: 14px;
    color: rgb(50, 50, 50);
    -unity-font-style: bold;
}

/* Custom Styled Slider */
.settings-slider {
    width: 100%;
    margin-top: 4px;
    margin-bottom: 4px;
}

.settings-slider #unity-tracker {
    height: 8px;
    background-color: rgb(215, 205, 185);
    border-radius: 4px;
    border-width: 0;
}

.settings-slider #unity-dragger {
    width: 20px;
    height: 20px;
    margin-top: -6px;
    border-radius: 10px;
    background-image: url("project://database/Assets/_Game/button_square_line.png?fileID=21300000&guid=1e32a606d3caf3743b11b6458d28ddcb&type=3#button_square_line");
    -unity-background-image-tint-color: rgb(255, 240, 201);
    background-color: transparent;
    border-width: 0;
}

.hidden {
    display: none;
}
